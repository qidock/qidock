<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Neutral materials preserve application icon colors and wallpaper visibility. -->
    <SolidColorBrush x:Key="TextPrimary" Color="#FFF1F3F5" />
    <SolidColorBrush x:Key="TextSecondary" Color="#FFADB5BF" />
    <SolidColorBrush x:Key="WindowsLogoBrush" Color="#FF54B6F5" />
    <SolidColorBrush x:Key="SurfaceKeyboardFocus" Color="#FF354652" />
    <SolidColorBrush x:Key="MenuStroke" Color="#30FFFFFF" />
    <LinearGradientBrush x:Key="MenuMaterial" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F5202227" Offset="0" />
        <GradientStop Color="#FA1B1D22" Offset="1" />
    </LinearGradientBrush>
    <!-- Frosted side panels (notification and control center): the tint over the blurred desktop and the tiles on it. -->
    <Color x:Key="PanelFrostTint">#C8191A1F</Color>
    <SolidColorBrush x:Key="PanelTile" Color="#1EFFFFFF" />
    <SolidColorBrush x:Key="PanelTileHover" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="PanelTileStroke" Color="#1AFFFFFF" />
    <!-- Widget popups stay nearly opaque regardless of the surface-opacity setting so text behind never shows through. -->
    <LinearGradientBrush x:Key="WidgetPopupFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FA1F2126" Offset="0" />
        <GradientStop Color="#FC1A1C21" Offset="1" />
    </LinearGradientBrush>
    <!-- Dock icon tiles (each app sits on a rounded glass square). -->
    <SolidColorBrush x:Key="DockTileFill" Color="#1CFFFFFF" />
    <SolidColorBrush x:Key="DockTileStroke" Color="#14FFFFFF" />
    <!-- Hover "liquid glass" bubble behind a dock icon: frosted fill, bright rim, top sheen. -->
    <LinearGradientBrush x:Key="GlassFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#3DFFFFFF" Offset="0" />
        <GradientStop Color="#14FFFFFF" Offset="0.55" />
        <GradientStop Color="#2BFFFFFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassRim" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E6FFFFFF" Offset="0" />
        <GradientStop Color="#33FFFFFF" Offset="0.4" />
        <GradientStop Color="#1AFFFFFF" Offset="0.62" />
        <GradientStop Color="#99FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassSheen" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#59FFFFFF" Offset="0" />
        <GradientStop Color="#00FFFFFF" Offset="0.5" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="GlassShade" Color="#40000000" />
    <LinearGradientBrush x:Key="StartTileFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF23252B" Offset="0" />
        <GradientStop Color="#FF0E0F12" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="StartLogoBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFFFF" Offset="0" />
        <GradientStop Color="#FFB4BBC6" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SurfacePopup" Color="#FF181C22" />
    <SolidColorBrush x:Key="StrokeSubtle" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="StrokeFocus" Color="#FFD0E8FA" />
    <SolidColorBrush x:Key="SurfaceHover" Color="#22FFFFFF" />
    <SolidColorBrush x:Key="SurfacePressed" Color="#34FFFFFF" />
    <SolidColorBrush x:Key="SurfaceSelected" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="SurfaceDanger" Color="#FFC43846" />
    <SolidColorBrush x:Key="NotificationBrush" Color="#FFFF6673" />
    <SolidColorBrush x:Key="IndicatorBrush" Color="#A8E4F3FF" />
    <SolidColorBrush x:Key="IndicatorForegroundBrush" Color="#FFFFFFFF" />
    <LinearGradientBrush x:Key="DockMaterial" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#CC1E2530" Offset="0" />
        <GradientStop Color="#E210141C" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DockBorderMaterial" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#4DFFFFFF" Offset="0" />
        <GradientStop Color="#16FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SettingsBackground" Color="#FF181A1E" />
    <SolidColorBrush x:Key="SettingsSidebar" Color="#FF121417" />
    <SolidColorBrush x:Key="SettingsControl" Color="#FF22252A" />
    <SolidColorBrush x:Key="SettingsControlHover" Color="#FF2B2F35" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FFB9D7EF" />
    <SolidColorBrush x:Key="AccentText" Color="#FF102332" />
    <SolidColorBrush x:Key="DangerText" Color="#FFFF9DA7" />
    <SolidColorBrush x:Key="MenuDivider" Color="#20FFFFFF" />
    <SolidColorBrush x:Key="SettingsSidebarOverlay" Color="#2410141A" />
    <SolidColorBrush x:Key="CaptionCloseForeground" Color="#FFFFFFFF" />
</ResourceDictionary>
