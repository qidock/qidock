<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>QiDock</AssemblyName>
    <RootNamespace>QiDock</RootNamespace>
    <Version>0.4.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/QiDock.ico</ApplicationIcon>
    <Product>QiDock</Product>
    <AssemblyTitle>QiDock</AssemblyTitle>
    <Company>QiDock</Company>
    <Authors>QiDock</Authors>
    <Copyright>Copyright (c) 2026 QiDock contributors</Copyright>
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=QiDock</PathMap>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
  </ItemGroup>

</Project>
